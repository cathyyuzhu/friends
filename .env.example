# LLM 后端：anthropic（默认）或 dashscope（阿里百炼，OpenAI 兼容接口）
LLM_PROVIDER=anthropic

# --- provider = anthropic 时需要 ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- provider = dashscope 时需要（阿里百炼）---
DASHSCOPE_API_KEY=sk-xxxxxxxx
# 可选，默认走官方兼容模式地址，一般不用改
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名。provider=anthropic 默认 claude-sonnet-5；provider=dashscope 默认 qwen-flash-character
# 阿里百炼下的模型都用同一个 key，换模型只需改这一项，比如 qwen-plus、qwen-max
FRIENDS_MODEL=claude-sonnet-5

# --- Telegram（跑 telegram_bot.py 才需要）---
# 每个人设一个 bot token，变量名是 TG_TOKEN_<人设ID大写>，ID 见 personas.json
TG_TOKEN_AZHE=
TG_TOKEN_YIN=
TG_TOKEN_SHUSHU=

# 哪个人设的 bot 用来监听群消息（需要在 BotFather 里 /setprivacy Disable），不填默认用第一个
TG_LISTENER_PERSONA_ID=azhe

# 群的 chat_id，第一次运行不用填，程序会自动检测并打印出来，之后填进来更稳妥
TG_GROUP_CHAT_ID=

# 朋友主动冒泡分享的时间间隔范围（分钟），测试时可以调小，比如 1 和 3
TG_SPONTANEOUS_MIN_MINUTES=90
TG_SPONTANEOUS_MAX_MINUTES=240

